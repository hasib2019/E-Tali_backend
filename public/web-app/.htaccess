# Expo web build served from /web-app (Apache / LiteSpeed). Generated by
# app/scripts/build-web-app.js — edit there, not here.
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # App routes (/web-app/party/12) get the SPA shell. Real files, folders and
  # anything with a file extension are left alone, so a missing .js is a 404
  # rather than HTML.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]+$
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Bundles and assets carry a content hash in their name; index.html doesn't,
  # so it must always be revalidated or users keep loading the old build.
  <FilesMatch "\.(js|wasm|ttf|woff2?|png|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
